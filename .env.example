# --- Server ---
PORT=8080
ARWEAVE_HOST=arweave.net
ARWEAVE_PORT=443
ARWEAVE_PROTOCOL=https
ARWEAVE_WALLET_JSON_PATH=./secrets/arweave-wallet.json
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_CHAIN_ID=196
REGISTRY_CONTRACT_ADDRESS=
REGISTRY_DEPLOYER_PRIVATE_KEY=
PAYMENTS_ENFORCED=false

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE==
PAY_TO_ADDRESS==
X402_NETWORK=eip155:196

# Note: x402 prices are hardcoded to $0.3 per call in server/index.js —
# no X402_PRICE_* env vars are read anymore (they previously drifted out
# of sync with the intended price on Railway).
REDIS_URL=

# --- Caller Signature Auth Gating ---
# Set to true to enforce wallet signature checks for writes/private reads.
CALLER_AUTH_ENFORCED=false

# --- A2A Provider Daemon (Railway only) ---
# The ASP agent ID registered on OKX.AI (e.g. 4961 for Cortex).
# When set, the server starts an XMTP watch loop to receive marketplace tasks.
OKX_A2A_AGENT_ID=
# Optional: path to the onchainos binary if not on PATH (Railway sets this automatically).
ONCHAINOS_BIN=onchainos
